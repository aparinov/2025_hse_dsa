# Скопируйте в .env: cp .env.example .env
# Для docker compose сервис БД называется db — хост из контейнера web: db

POSTGRES_DB=cusrach_db
POSTGRES_USER=cusrach_user
POSTGRES_PASSWORD=cusrach_pass

# Внутри Docker-сети порт Postgres всегда 5432 (5433 снаружи задаётся в docker-compose)
POSTGRES_HOST=db
POSTGRES_PORT=5432

SECRET_KEY=change-me-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
